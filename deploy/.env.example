# 复制为 .env 后按需修改。.env 不要提交到 git。

# MySQL root 密码（必填）。首次部署时生成一个强随机值。
MYSQL_ROOT_PASSWORD=

# 数据库名
MYSQL_DATABASE=mars_printer_hub

# 对外端口
BACKEND_PORT=18123
FRONTEND_PORT=18124

# 打印机接入方式
# BAMBU_CLOUD_ENABLED=true 使用 Bambu 云端（需要公网可达）
# BAMBU_INTRANET=true  局域网直连（与云端互斥）
BAMBU_CLOUD_ENABLED=false
BAMBU_INTRANET=true
BAMBU_MQTT_INIT_ALL=false
